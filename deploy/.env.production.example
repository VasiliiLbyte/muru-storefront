NEXT_PUBLIC_API_BASE=https://murushop.ru/api
# NEXT_PUBLIC_CATALOG_API_BASE не нужен — fallback на API_BASE
# NEXT_PUBLIC_API_MOCKING=  # не задавать
PORT=3000

# Required for production/staging builds (canonical / JSON-LD).
NEXT_PUBLIC_SITE_URL=https://web.murushop.ru

# --- Noindex (staging) — set BEFORE `npm run build` (headers() is build-time) ---
# Meta robots: NEXT_PUBLIC_NOINDEX or SITE_NOINDEX === "true"
NEXT_PUBLIC_NOINDEX=true
SITE_NOINDEX=true
# HTTP X-Robots-Tag: on if NOINDEX_HEADER OR SITE_NOINDEX OR NEXT_PUBLIC_NOINDEX === "true"
NOINDEX_HEADER=true

# Yandex Metrika — set only on production muru.ru (leave empty on staging/noindex).
# NEXT_PUBLIC_YANDEX_METRIKA_ID=112004619
